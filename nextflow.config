/*
============================================================
  RNA-seq Pipeline · nextflow.config
============================================================
*/

// ─── PARÀMETRES DEL PIPELINE ────────────────────────────
params {

    // Input
    samplesheet   = "samplesheet.csv"

    // Referència
    star_index    = "/path/to/star_index"     // MODIFICA
    gtf           = "/path/to/annotation.gtf" // MODIFICA

    // Output
    outdir        = "results"

    // featureCounts strandness: 0=unstranded 1=stranded 2=reverse
    fc_strandness = 0

    // Mínim counts totals per gen (filtratge matriu)
    min_counts    = 10
}

// ─── CONTENIDORS ────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "$HOME/.singularity/cache"
}

// Descomenta si tens Docker
// docker {
//     enabled = true
// }

// ─── PERFILS ────────────────────────────────────────────
profiles {

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'   // MODIFICA amb la teva cua
    }

    local {
        process.executor = 'local'
    }
}

// ─── RECURSOS PER PROCÉS ────────────────────────────────
process {

    cpus   = 4
    memory = '8 GB'
    time   = '2 h'

    withName: 'FASTQC' {
        cpus      = 2
        memory    = '4 GB'
        time      = '1 h'
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    withName: 'TRIMGALORE' {
        cpus      = 4
        memory    = '8 GB'
        time      = '2 h'
        container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0'
    }

    withName: 'STAR_ALIGN' {
        cpus      = 8
        memory    = '40 GB'
        time      = '4 h'
        container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0'
    }

    withName: 'SAMTOOLS_QC' {
        cpus      = 4
        memory    = '8 GB'
        time      = '1 h'
        container = 'quay.io/biocontainers/samtools:1.19--h50ea8bc_0'
    }

    withName: 'FEATURECOUNTS' {
        cpus      = 8
        memory    = '16 GB'
        time      = '2 h'
        container = 'quay.io/biocontainers/subread:2.0.6--he4a0461_0'
    }

    withName: 'MULTIQC' {
        cpus      = 2
        memory    = '4 GB'
        time      = '1 h'
        container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0'
    }
}

// ─── REPORTS NEXTFLOW ───────────────────────────────────
report   { enabled = true; file = "${params.outdir}/pipeline_report.html"   }
timeline { enabled = true; file = "${params.outdir}/pipeline_timeline.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_trace.txt"     }